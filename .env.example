# Anthropic: agents (Opus 5.5) + memory extraction (Sonnet 5.5)   [M1]
ANTHROPIC_API_KEY=

# GitHub fine-grained personal access token, test repo only   [M1]
GITHUB_TOKEN=

# Your login to the AgentSlack web UI   [M0]
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared secret between the API and the supervisor for /internal routes.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_SECRET=

# GitHub repo (owner/name) the seeded DEMO project works in
DEMO_REPO=

# Optional overrides; the defaults match docker-compose.yml
# DATABASE_URL=postgresql://agentslack:agentslack@localhost:5433/agentslack
# REDIS_URL=redis://localhost:6380
# API_PORT=4000
# WEB_ORIGIN=http://localhost:3002
# PR_POLL_MS=30000
# Supervisor: API URL as seen from inside laptop containers, and per-run spend caps in USD
# LAPTOP_API_URL=http://host.docker.internal:4000
# REPLY_BUDGET_USD=2
# TASK_BUDGET_USD=10
# Daily #standup post, HH:MM in the supervisor's local time (posted up to 3 h late), or "off"
# STANDUP_AT=09:30

# Laya router (M2): a self-hosted laya-serve picks model and effort per task.
# Unset: every agent uses its own model and effort. Below LAYA_MIN_CONFIDENCE or on error: Opus 5.5 at high effort.
# LAYA_URL=http://localhost:8000
# LAYA_API_KEY=
# LAYA_MIN_CONFIDENCE=0.6
# LAYA_TIMEOUT_MS=10000
# ROUTER_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
