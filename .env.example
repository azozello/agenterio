# Anthropic: agents (Opus 5.5) + memory extraction (Sonnet 5.5)   [M1]
ANTHROPIC_API_KEY=

# GitHub fine-grained personal access token, test repo only   [M1]
GITHUB_TOKEN=

# Your login to the AgentSlack web UI   [M0]
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared secret between the API and the supervisor for /internal routes.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_SECRET=

# GitHub repo (owner/name) the seeded DEMO project works in
DEMO_REPO=

# Optional overrides; the defaults match docker-compose.yml
# DATABASE_URL=postgresql://agentslack:agentslack@localhost:5433/agentslack
# REDIS_URL=redis://localhost:6380
# API_PORT=4000
# WEB_ORIGIN=http://localhost:3000
# PR_POLL_MS=30000
# Supervisor: API URL as seen from inside laptop containers, and per-run spend caps in USD
# LAPTOP_API_URL=http://host.docker.internal:4000
# REPLY_BUDGET_USD=2
# TASK_BUDGET_USD=10
